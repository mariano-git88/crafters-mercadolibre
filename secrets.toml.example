# Copiar a .streamlit/secrets.toml (local) o pegar en el panel de
# Streamlit Cloud (Settings -> Secrets).
#
# IMPORTANTE: este archivo es solo el ejemplo. El de verdad NUNCA se sube
# al repositorio: esta en el .gitignore.

# Contraseña para entrar a la app. Si se deja vacía no pide login
# (solo aceptable corriendo en tu propia máquina).
crafters_password = "poner-una-contraseña-larga"


# --- Credenciales de la aplicación de MercadoLibre --------------------
# Las mismas que están en credentials.txt. En la nube van acá porque
# credentials.txt no se sube al repo.
[mercadolibre]
app_id = "531270194124969"
secret_key = "poner-la-secret-key"
redirect_uri = "https://www.crafters.com.ar"


# --- Google Sheet donde viven el token y la auditoría -----------------
# Sin esto, en Streamlit Cloud se pierde el refresh_token en cada reinicio.
[gsheets]
spreadsheet_id = "poner-el-id-de-la-planilla"

# En local, apuntando a un archivo:
# service_account_json_path = ".gsheets/sa.json"

# En Streamlit Cloud, pegar el contenido del JSON del service account:
# [gsheets.service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
# auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
# client_x509_cert_url = "..."

# Sesión del panel de publicidad.
#
# MercadoLibre NO habilita la escritura de Product Ads por API para esta
# aplicación (contesta 401 "User does not have permission to write", incluso
# con el token de la cuenta dueña de los anunciantes). Las acciones sobre
# anuncios y campañas van por el endpoint interno del panel, que se
# autentica con cookies.
#
# Alcanza con `ssid`: F12 → Application → Cookies en ads.mercadolibre.com.ar.
# Está medido que el resto (_csrf, nsa_rotok, x-csrf-token) no hace falta.
#
# OJO: es una credencial de sesión web completa, más amplia que el token de
# OAuth. Quien la tenga opera la cuenta por web. Se corta si cerrás sesión en
# todos lados o cambiás la contraseña.
#
# Para el cron de GitHub Actions hay que copiar este archivo ENTERO al secret
# CRAFTERS_SECRETS_TOML del repo, que es distinto de los secrets de
# Streamlit Cloud.
[ads]
ssid = "ghy-XXXXXX-...-__-422682314-__-..."

# Parlata — para llevar las reseñas de MercadoLibre a la tienda Shopify.
# La API key se genera desde el panel de Parlata (requiere plan Growth).
[parlata]
api_key = "parlata_XXXXXXXX"
base_url = "https://parlata.fly.dev"
